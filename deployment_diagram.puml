@startuml Deployment Diagram
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho

node "Docker Host" {
  node "Nginx Container" {
    [Nginx] as NGINX
  }

  node "Backend Services" {
    [User Service] as US
    [Product Service] as PS
    [Order Service] as OS
    [Payment Service] as PAY
  }

  node "Database" {
    [PostgreSQL] as DB
  }

  node "Cache" {
    [Redis] as REDIS
  }
}

node "Client" {
  [Web Browser] as WB
  [Mobile App] as MA
}

' Connections
WB --> NGINX
MA --> NGINX

NGINX --> US
NGINX --> PS
NGINX --> OS
NGINX --> PAY

US --> DB
PS --> DB
OS --> DB
PAY --> DB

US --> REDIS
PS --> REDIS
OS --> REDIS
PAY --> REDIS

' Notes
note right of NGINX
  Reverse Proxy
  Load Balancer
  SSL Termination
end note

note right of DB
  PostgreSQL Database
  Persistent Storage
end note

note right of REDIS
  Cache Layer
  Session Storage
end note

@enduml 